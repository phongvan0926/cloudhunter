        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "# CONSTRAINT (R\303\200NG BU\341\273\230C)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "1. \306\257u ti\303\252n tuy\341\273\207t \304\221\341\273\221i t\303\254m ki\341\272\277m s\341\273\221 li\341\273\207u c\341\273\245 th\341\273\203 (Nhi\341\273\207t \304\221\341\273\231, \304\220i\341\273\203m s\306\260\306\241ng, Gi\303\263 c\303\241c t\341\272\247ng) \304\221\341\273\203 \304\221i\341\273\201n v\303\240o [HARD_DATA] tr\306\260\341\273\233c khi t\303\255nh to\303\241n."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "2. N\341\272\277u kh\303\264ng t\303\254m th\341\272\245y s\341\273\221 li\341\273\207u ch\303\255nh x\303\241c t\341\273\253 Search, h\303\243y \306\260\341\273\233c l\306\260\341\273\243ng d\341\273\261a tr\303\252n m\303\264 h\303\254nh ECMWF/GFS m\341\273\233i nh\341\272\245t \304\221\306\260\341\273\243c th\341\272\243o lu\341\272\255n tr\303\252n c\303\241c trang d\341\273\261 b\303\241o uy t\303\255n (Windy, Mountain-Forecast)."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "3. KH\303\224NG \304\220\306\257\341\273\242C t\341\273\261 b\341\273\213a s\341\273\221 li\341\273\207u v\303\264 c\304\203n c\341\273\251. B\341\272\241n ph\341\272\243i n\303\252u r\303\265 trong \"expert_advice\" n\341\272\277u d\341\273\257 li\341\273\207u l\303\240 \306\260\341\273\233c t\303\255nh."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "`;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "function removeVietnameseTones(str: string): string {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    str = str.replace(/\303\240|\303\241|\341\272\241|\341\272\243|\303\243|\303\242|\341\272\247|\341\272\245|\341\272\255|\341\272\251|\341\272\253|\304\203|\341\272\261|\341\272\257|\341\272\267|\341\272\263|\341\272\265/g,\"a\"); "
