  view_file {
    absolute_path_uri: "file:///types.ts"
    end_line: 65
    content: "export interface WeatherInput {\n  locationName: string;\n  startDate: string;\n  endDate: string;\n}\n\nexport interface TechnicalIndices {\n  LCL_base: string; // e.g., \"200m\"\n  FSI_score: number;\n  cloud_top_estimated: string; // e.g., \"2400m\"\n  wind_impact_level: \'Low\' | \'Medium\' | \'High\' | \'Destructive\';\n  moisture_type: \'Deep\' | \'Shallow\';\n}\n\nexport interface WeatherAnalysis {\n  general: string;\n  cloud_behavior: string;\n}\n\nexport interface DailyForecast {\n  date: string;\n  score: number;\n  status_code: \'STATIC\' | \'FLOWING\' | \'CLEAR\' | \'FOG\' | \'DISSIPATING\';\n  status_text: string;\n  technical_indices: TechnicalIndices; // Replaces old technical_data\n  weather_analysis: WeatherAnalysis;   // New field\n  expert_advice: string;\n  weather_summary: {\n    temp: string;\n    humidity: string;\n    wind: string;\n  };\n}\n\nexport interface TerrainPoint {\n  label: string;\n  altitude: number;\n  type: \'VALLEY\' | \'SLOPE\' | \'PEAK\' | \'RIDGE\';\n  description?: string; // Added to describe the waypoint (e.g. \"R\341\273\253ng hoa \304\221\341\273\227 quy\303\252n\")\n}\n\nexport interface TerrainAnalysis {\n  source?: \'HARDCODED\' | \'RESEARCHED\'; // New field to track data origin\n  summary: string;\n  cloud_trap_potential: \'High\' | \'Medium\' | \'Low\';\n  elevation_profile: TerrainPoint[];\n}\n\nexport interface CloudAnalysis {\n  locationName: string;\n  overallStrategy: string;\n  bestDays: string[]; \n  dailyForecasts: DailyForecast[];\n  gearChecklist: string[];\n  terrain_analysis: TerrainAnalysis;\n  sources?: { title: string; uri: string }[];\n}\n\nexport interface PeakPreset {\n  name: string;\n  altitude: number;\n  province: string;\n  elevation_profile?: TerrainPoint[]; // Added for static terrain consistency\n  aliases?: string[]; // Added for better matching (e.g. \"Bach Moc\" for \"Ky Quan San\")\n}\n"
    raw_content: "export interface WeatherInput {\n  locationName: string;\n  startDate: string;\n  endDate: string;\n}\n\nexport interface TechnicalIndices {\n  LCL_base: string; // e.g., \"200m\"\n  FSI_score: number;\n  cloud_top_estimated: string; // e.g., \"2400m\"\n  wind_impact_level: \'Low\' | \'Medium\' | \'High\' | \'Destructive\';\n  moisture_type: \'Deep\' | \'Shallow\';\n}\n\nexport interface WeatherAnalysis {\n  general: string;\n  cloud_behavior: string;\n}\n\nexport interface DailyForecast {\n  date: string;\n  score: number;\n  status_code: \'STATIC\' | \'FLOWING\' | \'CLEAR\' | \'FOG\' | \'DISSIPATING\';\n  status_text: string;\n  technical_indices: TechnicalIndices; // Replaces old technical_data\n  weather_analysis: WeatherAnalysis;   // New field\n  expert_advice: string;\n  weather_summary: {\n    temp: string;\n    humidity: string;\n    wind: string;\n  };\n}\n\nexport interface TerrainPoint {\n  label: string;\n  altitude: number;\n  type: \'VALLEY\' | \'SLOPE\' | \'PEAK\' | \'RIDGE\';\n  description?: string; // Added to describe the waypoint (e.g. \"R\341\273\253ng hoa \304\221\341\273\227 quy\303\252n\")\n}\n\nexport interface TerrainAnalysis {\n  source?: \'HARDCODED\' | \'RESEARCHED\'; // New field to track data origin\n  summary: string;\n  cloud_trap_potential: \'High\' | \'Medium\' | \'Low\';\n  elevation_profile: TerrainPoint[];\n}\n\nexport interface CloudAnalysis {\n  locationName: string;\n  overallStrategy: string;\n  bestDays: string[]; \n  dailyForecasts: DailyForecast[];\n  gearChecklist: string[];\n  terrain_analysis: TerrainAnalysis;\n  sources?: { title: string; uri: string }[];\n}\n\nexport interface PeakPreset {\n  name: string;\n  altitude: number;\n  province: string;\n  elevation_profile?: TerrainPoint[]; // Added for static terrain consistency\n  aliases?: string[]; // Added for better matching (e.g. \"Bach Moc\" for \"Ky Quan San\")\n}\n"
