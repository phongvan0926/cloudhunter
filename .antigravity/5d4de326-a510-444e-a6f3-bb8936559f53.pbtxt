        lines {
          text: "3. Kh\303\264ng c\303\263 d\341\273\257 li\341\273\207u v\341\273\201 Wind Shear ho\341\272\267c Dew Point Spread."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "H\303\243y s\341\273\255 d\341\273\245ng ch\303\272ng CH\341\273\210 \304\220\341\273\202 tham kh\341\272\243o t\303\254nh h\303\254nh th\341\273\261c t\341\272\277 (v\303\255 d\341\273\245: \341\272\243nh m\303\242y h\303\264m qua, t\303\254nh tr\341\272\241ng s\341\272\241t l\341\273\237 \304\221\306\260\341\273\235ng)."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "# CONSTRAINT (R\303\200NG BU\341\273\230C)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "1. \306\257u ti\303\252n tuy\341\273\207t \304\221\341\273\221i t\303\254m ki\341\272\277m s\341\273\221 li\341\273\207u c\341\273\245 th\341\273\203 (Nhi\341\273\207t \304\221\341\273\231, \304\220i\341\273\203m s\306\260\306\241ng, Gi\303\263 c\303\241c t\341\272\247ng) \304\221\341\273\203 \304\221i\341\273\201n v\303\240o [HARD_DATA] tr\306\260\341\273\233c khi t\303\255nh to\303\241n."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "2. N\341\272\277u kh\303\264ng t\303\254m th\341\272\245y s\341\273\221 li\341\273\207u ch\303\255nh x\303\241c t\341\273\253 Search, h\303\243y \306\260\341\273\233c l\306\260\341\273\243ng d\341\273\261a tr\303\252n m\303\264 h\303\254nh ECMWF/GFS m\341\273\233i nh\341\272\245t \304\221\306\260\341\273\243c th\341\272\243o lu\341\272\255n tr\303\252n c\303\241c trang d\341\273\261 b\303\241o uy t\303\255n (Windy, Mountain-Forecast)."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "3. KH\303\224NG \304\220\306\257\341\273\242C t\341\273\261 b\341\273\213a s\341\273\221 li\341\273\207u v\303\264 c\304\203n c\341\273\251. B\341\272\241n ph\341\272\243i n\303\252u r\303\265 trong \"expert_advice\" n\341\272\277u d\341\273\257 li\341\273\207u l\303\240 \306\260\341\273\233c t\303\255nh."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "`;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "function removeVietnameseTones(str: string): string {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    str = str.replace(/\303\240|\303\241|\341\272\241|\341\272\243|\303\243|\303\242|\341\272\247|\341\272\245|\341\272\255|\341\272\251|\341\272\253|\304\203|\341\272\261|\341\272\257|\341\272\267|\341\272\263|\341\272\265/g,\"a\"); "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    str = str.replace(/\303\250|\303\251|\341\272\271|\341\272\273|\341\272\275|\303\252|\341\273\201|\341\272\277|\341\273\207|\341\273\203|\341\273\205/g,\"e\"); "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    str = str.replace(/\303\254|\303\255|\341\273\213|\341\273\211|\304\251/g,\"i\"); "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    str = str.replace(/\303\262|\303\263|\341\273\215|\341\273\217|\303\265|\303\264|\341\273\223|\341\273\221|\341\273\231|\341\273\225|\341\273\227|\306\241|\341\273\235|\341\273\233|\341\273\243|\341\273\237|\341\273\241/g,\"o\"); "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    str = str.replace(/\303\271|\303\272|\341\273\245|\341\273\247|\305\251|\306\260|\341\273\253|\341\273\251|\341\273\261|\341\273\255|\341\273\257/g,\"u\"); "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    str = str.replace(/\341\273\263|\303\275|\341\273\265|\341\273\267|\341\273\271/g,\"y\"); "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    str = str.replace(/\304\221/g,\"d\");"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    str = str.replace(/\303\200|\303\201|\341\272\240|\341\272\242|\303\203|\303\202|\341\272\246|\341\272\244|\341\272\254|\341\272\250|\341\272\252|\304\202|\341\272\260|\341\272\256|\341\272\266|\341\272\262|\341\272\264/g, \"A\");"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    str = str.replace(/\303\210|\303\211|\341\272\270|\341\272\272|\341\272\274|\303\212|\341\273\200|\341\272\276|\341\273\206|\341\273\202|\341\273\204/g, \"E\");"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    str = str.replace(/\303\214|\303\215|\341\273\212|\341\273\210|\304\250/g, \"I\");"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    str = str.replace(/\303\222|\303\223|\341\273\214|\341\273\216|\303\225|\303\224|\341\273\222|\341\273\220|\341\273\230|\341\273\224|\341\273\226|\306\240|\341\273\234|\341\273\232|\341\273\242|\341\273\236|\341\273\240/g, \"O\");"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    str = str.replace(/\303\231|\303\232|\341\273\244|\341\273\246|\305\250|\306\257|\341\273\252|\341\273\250|\341\273\260|\341\273\254|\341\273\256/g, \"U\");"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    str = str.replace(/\341\273\262|\303\235|\341\273\264|\341\273\266|\341\273\270/g, \"Y\");"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    str = str.replace(/\304\220/g, \"D\");"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    return str.toLowerCase().trim();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "export const analyzeWeatherData = async (data: WeatherInput): Promise<CloudAnalysis> => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const start = new Date(data.startDate);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const end = new Date(data.endDate);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const diffTime = Math.abs(end.getTime() - start.getTime());"
