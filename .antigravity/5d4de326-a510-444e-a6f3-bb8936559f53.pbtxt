      replacement_content: "  let terrainContext = \"\";\n  if (matchedPreset && matchedPreset.elevation_profile) {\n    terrainContext = `\n    **KNOWN_LOCATIONS_LIBRARY (D\341\273\256 LI\341\273\206U \304\220\341\273\212A H\303\214NH \304\220\303\203 X\303\201C TH\341\273\260C):**\n    \304\220\303\242y l\303\240 d\341\273\257 li\341\273\207u chu\341\272\251n c\341\273\247a h\341\273\207 th\341\273\221ng cho \304\221\341\273\213a \304\221i\341\273\203m n\303\240y.\n    ${JSON.stringify(matchedPreset.elevation_profile)}\n    `;\n  }\n\n  // [TESTING INJECTION] - Hardcoded data for Y Ty testing\n  let hardcodedDataInjection = \"\";\n  if (normalizedInput.includes(\"y ty\")) {\n      hardcodedDataInjection = `\n      [TESTING_SCENARIO_ACTIVE]\n      Ng\306\260\341\273\235i d\303\271ng \304\221ang y\303\252u c\341\272\247u ch\341\272\241y th\341\273\255 nghi\341\273\207m (Simulation Mode) v\341\273\233i b\341\273\231 d\341\273\257 li\341\273\207u c\341\273\251ng sau cho ng\303\240y 24/02. \n      B\341\272\240N B\341\272\256T BU\341\273\230C PH\341\272\242I D\303\231NG S\341\273\220 LI\341\273\206U N\303\200Y \304\220\341\273\202 T\303\215NH TO\303\201N CHO NG\303\200Y 24/02, B\341\273\216 QUA D\341\273\256 LI\341\273\206U SEARCH CHO NG\303\200Y N\303\200Y.\n      \n      [HARD_DATA]\n      - Location Altitude: 1900m (Y T\303\275)\n      - T_surf (1900m): 15\302\260C\n      - Td_surf (1900m): 14\302\260C\n      - T_850 (1500m): 12\302\260C\n      - T_700 (3000m): 5\302\260C\n      - Wind_850: 8 km/h (\304\220\303\264ng Nam)\n      \n      H\303\203Y \303\201P D\341\273\244NG MODULE 6 \304\220\341\273\202 X\303\201C \304\220\341\273\212NH TR\341\272\240NG TH\303\201I M\303\202Y T\341\272\240I \304\220\341\273\230 CAO 1900M.\n      L\306\260u \303\275: T_850 (12\302\260C) < T_surf (15\302\260C) -> Ngh\341\273\213ch nhi\341\273\207t m\341\272\241nh. M\303\242y b\341\273\213 n\303\251n xu\341\273\221ng d\306\260\341\273\233i.\n      T\303\255nh to\303\241n Delta H = 1900m - Cloud_Top.\n      `;\n  }\n\n  // Updated Prompt with strict SOURCE PRIORITY, Description Extraction, and MISSING DATA PROTOCOL\n  const prompt = `\n    D\341\273\261 b\303\241o s\304\203n m\303\242y cho: \"${data.locationName}\".\n    Ng\303\240y: ${data.startDate} \304\221\341\272\277n ${data.endDate} (${diffDays} ng\303\240y).\n    ${terrainContext}\n    ${hardcodedDataInjection}\n\n    NHI\341\273\206M V\341\273\244 C\341\273\246A B\341\272\240N:"
    }
