225 Tr\303\242u)\', \n    altitude: 2996, \n    province: \'Lai Ch\303\242u\',\n    aliases: [\'ta lien son\', \'co trau\', \'ta leng\', \'t\341\272\243 li\303\252n\', \'t\341\272\243 li\303\252n s\306\241n\'],\n    elevation_profile: [\n      { label: \'T\341\272\243 L\303\250ng\', altitude: 1000, type: \'VALLEY\', description: \'B\341\272\243n ng\306\260\341\273\235i Dao, ru\341\273\231ng b\341\272\255c thang\' },\n      { label: \'R\341\273\253ng C\341\273\225 Th\341\273\245\', altitude: 2200, type: \'SLOPE\', description: \'R\341\273\253ng r\303\252u phong ma m\341\273\213 nh\306\260 c\341\273\225 t\303\255ch\' },\n      { label: \'H\341\273\221c \304\220\303\241\', altitude: 2600, type: \'RIDGE\', description: \'Hang \304\221\303\241 tr\303\272 \341\272\251n t\341\273\261 nhi\303\252n, r\341\273\253ng tr\303\272c\' },\n      { label: \'\304\220\341\273\211nh T\341\272\243 Li\303\252n\', altitude: 2996, type: \'PEAK\', description: \'View nh\303\254n sang Putaleng, r\341\273\253ng \304\220\341\273\227 Quy\303\252n\' }\n    ]\n  },\n  { \n    name: \'\304\220\303\250o \303\224 Quy H\341\273\223\', \n    altitude: 2035, \n    province: \'Lai Ch\303\242u\',\n    aliases: [\'o quy ho\', \'cong troi\', \'deo o quy ho\', \'\303\264 quy h\341\273\223\', \'c\341\273\225ng tr\341\273\235i\', \'o quy ho pass\'],\n    elevation_profile: [\n      { label: \'Th\303\241c B\341\272\241c\', altitude: 1700, type: \'VALLEY\', description: \'Khu du l\341\273\213ch Th\303\241c B\341\272\241c, ph\303\255a Sapa\' },\n      { label: \'C\341\273\225ng Tr\341\273\235i\', altitude: 2035, type: \'PEAK\', description: \'\304\220\341\273\211nh \304\221\303\250o cao nh\341\272\245t Vi\341\273\207t Nam, gi\303\263 m\341\272\241nh\' },\n      { label: \'C\341\272\247u K\303\255nh\', altitude: 2100, type: \'RIDGE\', description: \'Khu du l\341\273\213ch R\341\273\223ng M\303\242y, thang m\303\241y ngo\303\240i tr\341\273\235i\' },\n      { label: \'Chu Va\', altitude: 1000, type: \'VALLEY\', description: \'Thung l\305\251ng ph\303\255a Lai Ch\303\242u, tr\341\273\235i \341\272\245m h\306\241n\' }\n    ]\n  }\n];\n\nexport const SKY_CONDITIONS = [\n  \'Clear (Quang m\303\242y)\',\n  \'Partly Cloudy (C\303\263 m\303\242y r\341\272\243i r\303\241c)\',\n  \'Cloudy (Nhi\341\273\201u m\303\242y)\',\n  \'Foggy (S\306\260\306\241ng m\303\271)\',\n  \'Rainy (M\306\260a)\',\n];\n"
