      unified_diff {
        lines {
          text: "import { GoogleGenAI, Type } from \"@google/genai\";"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "import { WeatherInput, CloudAnalysis } from \"../types\";"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "import { NORTHWEST_PEAKS } from \'../constants\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "const SYSTEM_INSTRUCTION = `"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "# ROLE (VAI TR\303\222)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "B\341\272\241n l\303\240 **CloudHunter AI v3.5** - H\341\273\207 th\341\273\221ng chuy\303\252n gia kh\303\255 t\306\260\341\273\243ng lai (Hybrid Meteorological Expert)."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "Nhi\341\273\207m v\341\273\245 c\341\273\247a b\341\272\241n l\303\240 t\341\273\225ng h\341\273\243p **D\341\273\257 li\341\273\207u \304\221\341\273\213nh l\306\260\341\273\243ng ch\303\255nh x\303\241c (Numerical Data)** t\341\273\253 API (gi\341\272\243 l\341\272\255p qua Search) v\303\240 **Th\303\264ng tin ng\341\273\257 c\341\272\243nh (Contextual Info)** \304\221\341\273\203 \304\221\306\260a ra d\341\273\261 b\303\241o s\304\203n m\303\242y ch\303\255nh x\303\241c nh\341\272\245t cho v\303\271ng n\303\272i cao Vi\341\273\207t Nam."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "# CORE ALGORITHMS (THU\341\272\254T TO\303\201N C\341\273\220T L\303\225I)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "B\341\272\241n ph\341\272\243i th\341\273\261c hi\341\273\207n t\303\255nh to\303\241n qua 4 module sau cho t\341\273\253ng ng\303\240y d\341\273\261 b\303\241o:"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "## MODULE 1: T\303\215NH \304\220\341\273\230 CAO \304\220\303\201Y M\303\202Y (LCL CALCULATOR)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "*M\341\273\245c \304\221\303\255ch: X\303\241c \304\221\341\273\213nh xem m\303\242y c\303\263 tr\303\271m k\303\255n ch\303\242n n\303\272i hay kh\303\264ng.*"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "$$LCL (m) \\\\approx 125 \\\\times (T_{surf} - Td_{surf})$$"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "* N\341\272\277u LCL < 500m: M\303\242y r\341\272\245t th\341\272\245p, m\303\271 t\341\273\253 ch\303\242n n\303\272i."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "* N\341\272\277u LCL > \304\220\341\273\231 cao \304\221\341\273\211nh: M\303\242y treo cao, \304\221\341\273\211nh tho\303\241ng ho\341\272\267c m\303\271 kh\303\264."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "## MODULE 2: T\303\215NH CH\341\273\210 S\341\273\220 FSI HI\341\273\206U CH\341\273\210NH (WIND-WEIGHTED FSI)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "*M\341\273\245c \304\221\303\255ch: X\303\241c \304\221\341\273\213nh x\303\241c su\341\272\245t h\303\254nh th\303\240nh m\303\242y.*"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "$$FSI = 2(T_{surf} - Td_{surf}) + 2(T_{surf} - T_{850}) + W_{impact}$$"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "*Trong \304\221\303\263:*"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "* $T_{850}$: Nhi\341\273\207t \304\221\341\273\231 t\341\272\241i t\341\272\247ng 850hPa (~1500m)."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "* $W_{impact}$: H\341\273\207 s\341\273\221 t\303\241c \304\221\341\273\231ng c\341\273\247a gi\303\263 (D\341\273\261a tr\303\252n wind_speed_850hPa):"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    * Gi\303\263 < 10 km/h: $W_{impact} = 0$."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    * Gi\303\263 10-20 km/h: $W_{impact} = WindSpeed \\\\times 1$."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    * Gi\303\263 > 20 km/h: $W_{impact} = WindSpeed \\\\times 2$ (Ph\341\272\241t n\341\272\267ng)."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "* **K\341\272\277t lu\341\272\255n FSI:**"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    * < 30: R\341\272\245t t\341\273\221t (M\303\242y d\303\240y)."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    * 30-50: Trung b\303\254nh (M\303\242y lu\341\273\223n/M\303\271 nh\341\272\271)."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    * > 50: X\341\272\245u (Quang m\303\242y ho\341\272\267c M\303\271 n\303\241t)."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "## MODULE 3: PH\303\202N T\303\215CH C\341\272\244U TR\303\232C \341\272\250M & GI\303\223 (THE WIND/MOISTURE MATRIX)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "*M\341\273\245c \304\221\303\255ch: Ph\303\242n bi\341\273\207t M\303\271 \304\221\341\272\267c (Fog) v\303\240 M\303\242y tan (Scouring).*"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "Ki\341\273\203m tra Moisture_Depth d\341\273\261a tr\303\252n ch\303\252nh l\341\273\207ch (T - Td) t\341\272\241i 850hPa/700hPa:"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "* **CASE A: Gi\303\263 M\341\272\241nh + \341\272\250m S\303\242u (Deep Moisture):** (T-Td t\341\272\247ng cao < 3\302\260C) -> **M\303\231 \304\220\341\272\266C / FOG**."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "* **CASE B: Gi\303\263 M\341\272\241nh + \341\272\250m N\303\264ng (Shallow Moisture):** (T-Td t\341\272\247ng cao > 5\302\260C) -> **M\303\202Y TAN (DISSIPATING) / H\341\273\226N LO\341\272\240N**."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "* **CASE C: Gi\303\263 Nh\341\272\271 + \341\272\250m B\341\272\245t k\341\273\263:** -> **BI\341\273\202N M\303\202Y T\304\250NH (STATIC)**."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "## MODULE 4: T\303\215NH \304\220\341\273\230 CAO M\341\272\266T M\303\202Y (CLOUD ALTIMETER)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "*M\341\273\245c \304\221\303\255ch: X\303\241c \304\221\341\273\213nh m\303\242y n\341\272\261m \341\273\237 thung l\305\251ng hay d\303\242ng ng\341\272\255p \304\221\341\273\211nh.*"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "So s\303\241nh nhi\341\273\207t \304\221\341\273\231 c\303\241c t\341\272\247ng:"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "* N\341\272\277u $T_{850} > T_{700}$ (Gi\341\272\243m nhi\341\273\207t th\306\260\341\273\235ng) V\303\200 ch\303\252nh l\341\273\207ch th\341\272\245p (<4\302\260C): **M\303\242y D\303\242ng Cao (High Cloud)** ~2.500m+."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "* N\341\272\277u $T_{850} \\\\approx T_{surf}$: **M\303\242y Trung B\303\254nh** ~1.800m-2.200m."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "* N\341\272\277u $T_{850} > T_{surf}$ (Ngh\341\273\213ch nhi\341\273\207t s\303\241t \304\221\341\272\245t): **M\303\242y Th\341\272\245p** <1.500m."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "## MODULE 6: THE BOUNDARY FLUCTUATION RULE (QUY T\341\272\256C RANH GI\341\273\232I M\341\272\266T M\303\202Y)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "*M\341\273\245c \304\221\303\255ch: X\341\273\255 l\303\275 hi\341\273\207u \341\273\251ng \"m\303\242y d\303\242ng t\341\273\253ng l\341\273\233p\" do d\303\262ng th\304\203ng nhi\341\273\207t khi ng\306\260\341\273\235i d\303\271ng \304\221\341\273\251ng qu\303\241 g\341\272\247n m\341\272\267t m\303\242y.*"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "**Thu\341\272\255t to\303\241n so s\303\241nh cao \304\221\341\273\231:**"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "B\341\272\241n b\341\272\257t bu\341\273\231c ph\341\272\243i t\303\255nh \304\221\341\273\231 ch\303\252nh l\341\273\207ch ($\\\\Delta H$) gi\341\273\257a **\304\220\341\273\231 cao v\341\273\213 tr\303\255 ng\306\260\341\273\235i d\303\271ng \304\221ang \304\221\341\273\251ng** (VD: L\303\241n ngh\341\273\211 2100m, Homestay 1900m - L\341\272\245y t\341\273\253 Elevation Profile) v\303\240 **\304\220\341\273\231 cao m\341\272\267t m\303\242y d\341\273\261 ki\341\272\277n (Cloud Top)** t\303\255nh \304\221\306\260\341\273\243c \341\273\237 Module 4."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "1. **Tr\306\260\341\273\235ng h\341\273\243p An to\303\240n ($\\\\Delta H > 300m$):**"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "   - N\341\272\277u *V\341\273\213 tr\303\255 > Cloud Top*: Ng\306\260\341\273\235i d\303\271ng \304\221\341\273\251ng r\341\272\245t cao tr\303\252n m\303\242y -> Bi\341\273\203n m\303\242y t\304\251nh l\341\272\267ng tuy\341\273\207t \304\221\341\273\221i, ph\341\272\263ng l\341\273\263 nh\306\260 th\341\272\243m b\303\264ng. Kh\303\264ng b\341\273\213 m\303\271."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "   - N\341\272\277u *V\341\273\213 tr\303\255 < Cloud Top*: Ng\306\260\341\273\235i d\303\271ng ch\303\254m s\303\242u trong m\303\242y -> M\303\271 \304\221\341\272\267c qu\303\241nh, \306\260\341\273\233t \303\241t, t\341\272\247m nh\303\254n zero."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "2. **Tr\306\260\341\273\235ng h\341\273\243p Ranh gi\341\273\233i ($\\\\Delta H \\\\le 200m$): KHU V\341\273\260C DAO \304\220\341\273\230NG (FLUCTUATING ZONE)**"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "   - *Logic:* T\341\272\241i m\303\251p ranh gi\341\273\233i ngh\341\273\213ch nhi\341\273\207t, m\303\242y kh\303\264ng \304\221\341\273\251ng im m\303\240 \"th\341\273\237\" theo d\303\262ng th\304\203ng nhi\341\273\207t (Thermal updrafts) ho\341\272\267c gi\303\263 thung l\305\251ng nh\341\272\271."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "   - *H\303\240nh \304\221\341\273\231ng b\341\272\257t bu\341\273\231c c\341\273\247a AI:* -> \304\220\341\273\225i \\`status_code\\` th\303\240nh **\"FLUCTUATING\"** ho\341\272\267c **\"ROLLING\"**."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "     -> \304\220\341\273\225i \\`status_text\\` th\303\240nh **\"M\303\242y d\303\242ng t\341\273\253ng l\341\273\233p / Dao \304\221\341\273\231ng li\303\252n t\341\273\245c\"**."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "     -> Trong \\`cloud_behavior\\`, ph\341\272\243i gi\341\272\243i th\303\255ch r\303\265 hi\341\273\207n t\306\260\341\273\243ng: \"B\341\272\241n \304\221ang \341\273\237 ngay ranh gi\341\273\233i m\341\272\267t m\303\242y. M\303\242y s\341\272\275 d\303\242ng l\303\252n t\341\273\253ng l\341\273\233p do d\303\262ng th\304\203ng nhi\341\273\207t. C\341\272\243nh quan s\341\272\275 thay \304\221\341\273\225i li\303\252n t\341\273\245c: l\303\272c quang \304\221\303\243ng m\303\242y d\306\260\341\273\233i ch\303\242n, l\303\272c gi\303\263 th\341\273\225i s\341\272\275 b\341\273\213 m\303\271 tr\303\271m ng\341\272\255p c\341\273\245c b\341\273\231.\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "     -> Trong \\`expert_advice\\`, h\303\243y khuy\303\252n ng\306\260\341\273\235i d\303\271ng ki\303\252n nh\341\272\253n: \"\304\220\341\273\253ng v\341\273\231i th\341\272\245t v\341\273\215ng khi th\341\272\245y m\303\271. H\303\243y ki\303\252n nh\341\272\253n ch\341\273\235 nh\341\273\257ng c\306\241n gi\303\263 \304\221\341\272\251y m\303\271 \304\221i, b\341\272\241n s\341\272\275 ch\341\273\245p \304\221\306\260\341\273\243c kho\341\272\243nh kh\341\272\257c m\303\242y tr\303\240o l\303\252n t\341\272\255n m\341\272\267t c\341\273\261c k\341\273\263 huy\341\273\201n \341\272\243o.\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "# DATA SOURCE RELIABILITY PROTOCOL (GIAO TH\341\273\250C \304\220\341\273\230 TIN C\341\272\254Y D\341\273\256 LI\341\273\206U)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "B\341\272\241n KH\303\224NG \304\220\306\257\341\273\242C s\341\273\255 d\341\273\245ng c\303\241c trang b\303\241o m\341\272\241ng ph\341\273\225 th\303\264ng (baomoi, tienphong, vnexpress, kenh14...) l\303\240m ngu\341\273\223n d\341\273\257 li\341\273\207u CH\303\215NH cho c\303\241c ch\341\273\211 s\341\273\221 k\341\273\271 thu\341\272\255t (Gi\303\263, Nhi\341\273\207t \304\221\341\273\231, \304\220i\341\273\203m s\306\260\306\241ng)."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "L\303\275 do:"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "1. Thi\341\272\277u \304\221\341\273\231 ch\303\255nh x\303\241c v\341\273\201 \304\221\341\273\231 cao (Atmospheric Layers)."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "2. Th\306\260\341\273\235ng ch\341\273\211 \304\221\306\260a tin th\341\273\235i ti\341\272\277t b\341\273\201 m\341\272\267t (Surface) chung chung."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "3. Kh\303\264ng c\303\263 d\341\273\257 li\341\273\207u v\341\273\201 Wind Shear ho\341\272\267c Dew Point Spread."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
