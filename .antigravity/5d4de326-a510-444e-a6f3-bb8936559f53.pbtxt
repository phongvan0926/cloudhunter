        }
        lines {
          text: "    str = str.replace(/\303\250|\303\251|\341\272\271|\341\272\273|\341\272\275|\303\252|\341\273\201|\341\272\277|\341\273\207|\341\273\203|\341\273\205/g,\"e\"); "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    str = str.replace(/\303\254|\303\255|\341\273\213|\341\273\211|\304\251/g,\"i\"); "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    str = str.replace(/\303\262|\303\263|\341\273\215|\341\273\217|\303\265|\303\264|\341\273\223|\341\273\221|\341\273\231|\341\273\225|\341\273\227|\306\241|\341\273\235|\341\273\233|\341\273\243|\341\273\237|\341\273\241/g,\"o\"); "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    str = str.replace(/\303\271|\303\272|\341\273\245|\341\273\247|\305\251|\306\260|\341\273\253|\341\273\251|\341\273\261|\341\273\255|\341\273\257/g,\"u\"); "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    str = str.replace(/\341\273\263|\303\275|\341\273\265|\341\273\267|\341\273\271/g,\"y\"); "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    str = str.replace(/\304\221/g,\"d\");"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    str = str.replace(/\303\200|\303\201|\341\272\240|\341\272\242|\303\203|\303\202|\341\272\246|\341\272\244|\341\272\254|\341\272\250|\341\272\252|\304\202|\341\272\260|\341\272\256|\341\272\266|\341\272\262|\341\272\264/g, \"A\");"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    str = str.replace(/\303\210|\303\211|\341\272\270|\341\272\272|\341\272\274|\303\212|\341\273\200|\341\272\276|\341\273\206|\341\273\202|\341\273\204/g, \"E\");"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    str = str.replace(/\303\214|\303\215|\341\273\212|\341\273\210|\304\250/g, \"I\");"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    str = str.replace(/\303\222|\303\223|\341\273\214|\341\273\216|\303\225|\303\224|\341\273\222|\341\273\220|\341\273\230|\341\273\224|\341\273\226|\306\240|\341\273\234|\341\273\232|\341\273\242|\341\273\236|\341\273\240/g, \"O\");"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    str = str.replace(/\303\231|\303\232|\341\273\244|\341\273\246|\305\250|\306\257|\341\273\252|\341\273\250|\341\273\260|\341\273\254|\341\273\256/g, \"U\");"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    str = str.replace(/\341\273\262|\303\235|\341\273\264|\341\273\266|\341\273\270/g, \"Y\");"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    str = str.replace(/\304\220/g, \"D\");"
